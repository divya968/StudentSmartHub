# Local development defaults (SQLite; no MySQL installation required)
DEBUG=True
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-before-deployment
ALLOWED_HOSTS=localhost,127.0.0.1

# Optional Gmail SMTP for real password-reset emails. Use a Google App Password.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=youraddress@gmail.com
EMAIL_HOST_PASSWORD=your_16_character_google_app_password
DEFAULT_FROM_EMAIL=Student Smart Hub <youraddress@gmail.com>
EMAIL_TIMEOUT=20

# Optional MySQL instead of SQLite: uncomment and fill all DB values.
# DB_NAME=student_smart_hub
# DB_USER=root
# DB_PASSWORD=your_mysql_password
# DB_HOST=localhost
# DB_PORT=3306

# Optional integrations
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
DEMO_MODE=False
